{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gurps-sheet:schema:gurps-character:1.0.0",
  "title": "GURPS 4th Edition Character",
  "description": "Engine-neutral GURPS 4e character document. Keys are English; free-text content is in the language declared by meta.locale. Every parameter carries an `x-gurps` annotation (role, formula, unit, cost, Basic Set reference, original sheet field, localized label). Derived values are stored for convenience and can be recomputed from their formulas with the rule tables in `x-gurps-tables` (see schema/README.md for the expression language).",
  "type": "object",
  "required": ["format", "formatVersion", "ruleset", "meta", "profile", "points", "attributes", "secondary", "encumbrance", "damage", "defenses", "traits", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "Optional schema URI for editor tooling." },
    "format": { "const": "gurps-character" },
    "formatVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Semantic version of this schema the document conforms to. Minor versions only add optional properties."
    },
    "ruleset": {
      "type": "object",
      "required": ["system", "edition", "units"],
      "additionalProperties": false,
      "properties": {
        "system": { "const": "GURPS" },
        "edition": { "const": 4 },
        "units": {
          "enum": ["metric"],
          "description": "Measurement system used by every unit-bearing value (kg, m, m/s). Metric per the pt-BR Módulo Básico: Basic Lift = ST×ST/10 kg."
        },
        "currency": { "type": "string", "default": "$", "description": "Currency symbol for cost values." }
      }
    },
    "meta": {
      "type": "object",
      "required": ["locale"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "description": "BCP 47 language of free-text content (names, notes).", "examples": ["pt-BR", "en"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "generator": {
          "type": "object",
          "required": ["name"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "x-gurps": { "role": "input", "sheetField": "Nome", "label": { "pt-BR": "Nome" } } },
        "player": { "type": "string", "x-gurps": { "role": "input", "sheetField": "Jogador", "label": { "pt-BR": "Jogador" } } },
        "height": { "type": "string", "x-gurps": { "role": "input", "sheetField": "Altura", "label": { "pt-BR": "Altura" } } },
        "weight": { "type": "string", "description": "Body weight (not carried load).", "x-gurps": { "role": "input", "sheetField": "Peso", "label": { "pt-BR": "Peso" } } },
        "age": { "type": "string", "x-gurps": { "role": "input", "sheetField": "Idade", "label": { "pt-BR": "Idade" } } },
        "sizeModifier": { "type": "integer", "default": 0, "x-gurps": { "role": "input", "default": 0, "reference": "B19", "sheetField": "ModificadorTamanho", "label": { "pt-BR": "Mod. de Tamanho" } } },
        "appearance": { "type": "string", "description": "Physical description.", "x-gurps": { "role": "input", "sheetField": "Aparência", "label": { "pt-BR": "Aparência" } } }
      }
    },
    "points": {
      "type": "object",
      "required": ["spent", "breakdown"],
      "additionalProperties": false,
      "properties": {
        "budget": {
          "type": ["integer", "null"],
          "description": "Campaign point budget set by the GM.",
          "x-gurps": { "role": "input", "unit": "points", "sheetField": "Pontos_Gastar", "label": { "pt-BR": "Pontos p/ Gastar" } }
        },
        "spent": {
          "type": "number",
          "x-gurps": { "role": "derived", "unit": "points", "formula": "breakdown.attributes + breakdown.advantages + breakdown.disadvantages + breakdown.skills + breakdown.other", "sheetField": "Total_Pontos", "label": { "pt-BR": "Total de Pontos" } }
        },
        "unspent": {
          "type": ["number", "null"],
          "x-gurps": { "role": "derived", "unit": "points", "formula": "budget - spent", "label": { "pt-BR": "Pontos não gastos" } }
        },
        "breakdown": {
          "type": "object",
          "required": ["attributes", "advantages", "disadvantages", "skills", "other"],
          "additionalProperties": false,
          "properties": {
            "attributes": {
              "type": "number",
              "description": "Primary attributes plus secondary characteristics.",
              "x-gurps": { "role": "derived", "unit": "points", "formula": "$.attributes.st.points + $.attributes.dx.points + $.attributes.iq.points + $.attributes.ht.points + $.secondary.hp.points + $.secondary.will.points + $.secondary.per.points + $.secondary.fp.points + $.secondary.basicSpeed.points + $.secondary.basicMove.points", "sheetField": "Resumo_Pontos1", "label": { "pt-BR": "Atributos/Características Secundárias" } }
            },
            "advantages": {
              "type": "number",
              "description": "Advantages and perks, plus languages, cultural familiarities and tech level.",
              "x-gurps": { "role": "derived", "unit": "points", "formula": "sum($.traits[type=advantage|perk].points) + sum($.languages.points) + sum($.culturalFamiliarities.points) + sum($.techLevel.points)", "sheetField": "Resumo_Pontos2", "label": { "pt-BR": "Vantagens/Qualidades/NT/Idiomas/Familiaridade Cultural" } }
            },
            "disadvantages": {
              "type": "number",
              "x-gurps": { "role": "derived", "unit": "points", "formula": "sum($.traits[type=disadvantage|quirk].points)", "sheetField": "Resumo_Pontos3", "label": { "pt-BR": "Desvantagens/Peculiaridades" } }
            },
            "skills": {
              "type": "number",
              "x-gurps": { "role": "derived", "unit": "points", "formula": "sum($.skills.points)", "sheetField": "Resumo_Pontos4", "label": { "pt-BR": "Perícias/Técnicas" } }
            },
            "other": {
              "type": "number",
              "default": 0,
              "x-gurps": { "role": "input", "unit": "points", "default": 0, "sheetField": "Resumo_Pontos5", "label": { "pt-BR": "Outros" } }
            }
          }
        }
      }
    },
    "attributes": {
      "type": "object",
      "required": ["st", "dx", "iq", "ht"],
      "additionalProperties": false,
      "properties": {
        "st": { "$ref": "#/$defs/primaryAttribute", "title": "Strength", "x-gurps": { "costPerLevel": 10, "reference": "B14", "sheetField": "ST", "label": { "pt-BR": "ST (Força)" } } },
        "dx": { "$ref": "#/$defs/primaryAttributeDxIq", "title": "Dexterity", "x-gurps": { "costPerLevel": 20, "reference": "B15", "sheetField": "DX", "label": { "pt-BR": "DX (Destreza)" } } },
        "iq": { "$ref": "#/$defs/primaryAttributeDxIq", "title": "Intelligence", "x-gurps": { "costPerLevel": 20, "reference": "B15", "sheetField": "IQ", "label": { "pt-BR": "IQ (Inteligência)" } } },
        "ht": { "$ref": "#/$defs/primaryAttribute", "title": "Health", "x-gurps": { "costPerLevel": 10, "reference": "B15", "sheetField": "HT", "label": { "pt-BR": "HT (Vitalidade)" } } }
      }
    },
    "secondary": {
      "type": "object",
      "required": ["hp", "will", "per", "fp", "basicSpeed", "basicMove"],
      "additionalProperties": false,
      "properties": {
        "hp": {
          "title": "Hit Points",
          "type": "object",
          "required": ["value", "base", "points"],
          "additionalProperties": false,
          "x-gurps": { "costPerLevel": 2, "reference": "B16", "sheetField": "PV", "label": { "pt-BR": "PV (Pontos de Vida)" } },
          "properties": {
            "value": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "base", "description": "Bought value; defaults to base." } },
            "base": { "type": "integer", "x-gurps": { "role": "derived", "formula": "$.attributes.st.value" } },
            "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - base) * 2", "sheetField": "Custo_PV" } },
            "current": { "type": "integer", "x-gurps": { "role": "state", "description": "Current HP during play.", "sheetField": "PV_Atual", "label": { "pt-BR": "PV atual" } } }
          }
        },
        "will": { "$ref": "#/$defs/secondaryFromIq5", "title": "Will", "x-gurps": { "reference": "B16", "sheetField": "Vont", "label": { "pt-BR": "Vontade" } } },
        "per": { "$ref": "#/$defs/secondaryFromIq5", "title": "Perception", "x-gurps": { "reference": "B16", "sheetField": "Per", "label": { "pt-BR": "Percepção" } } },
        "fp": {
          "title": "Fatigue Points",
          "type": "object",
          "required": ["value", "base", "points"],
          "additionalProperties": false,
          "x-gurps": { "costPerLevel": 3, "reference": "B16", "sheetField": "PF", "label": { "pt-BR": "PF (Pontos de Fadiga)" } },
          "properties": {
            "value": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "base" } },
            "base": { "type": "integer", "x-gurps": { "role": "derived", "formula": "$.attributes.ht.value" } },
            "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - base) * 3", "sheetField": "Custo_PF" } },
            "current": { "type": "integer", "x-gurps": { "role": "state", "description": "Current FP during play.", "sheetField": "PF_Atual", "label": { "pt-BR": "PF atual" } } }
          }
        },
        "basicSpeed": {
          "title": "Basic Speed",
          "type": "object",
          "required": ["value", "base", "points"],
          "additionalProperties": false,
          "x-gurps": { "costPerLevel": 20, "unit": "m/s", "reference": "B17", "sheetField": "Vel_Basica", "label": { "pt-BR": "Velocidade Básica" }, "description": "Cost is per +1.00 (5 points per +0.25)." },
          "properties": {
            "value": { "type": "number", "multipleOf": 0.25, "x-gurps": { "role": "overridable", "formula": "base" } },
            "base": { "type": "number", "multipleOf": 0.25, "x-gurps": { "role": "derived", "formula": "($.attributes.dx.value + $.attributes.ht.value) / 4" } },
            "points": { "type": "number", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - base) * 20", "sheetField": "Custo_Vel_Basica" } }
          }
        },
        "basicMove": {
          "title": "Basic Move",
          "type": "object",
          "required": ["value", "base", "points"],
          "additionalProperties": false,
          "x-gurps": { "costPerLevel": 5, "unit": "m", "reference": "B17", "sheetField": "Desl_Basico", "label": { "pt-BR": "Deslocamento Básico" } },
          "properties": {
            "value": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "base" } },
            "base": { "type": "integer", "x-gurps": { "role": "derived", "formula": "floor($.secondary.basicSpeed.value)" } },
            "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - base) * 5", "sheetField": "Custo_Desl_Basico" } }
          }
        }
      }
    },
    "encumbrance": {
      "type": "object",
      "required": ["basicLift", "levels"],
      "additionalProperties": false,
      "properties": {
        "basicLift": {
          "type": "number",
          "minimum": 0,
          "description": "ST×ST/10 kg, rounded to whole kg when 10 or more.",
          "x-gurps": { "role": "overridable", "unit": "kg", "reference": "B15", "formula": "if($.attributes.st.value * $.attributes.st.value / 10 >= 10, round($.attributes.st.value * $.attributes.st.value / 10), round($.attributes.st.value * $.attributes.st.value / 10, 1))", "sheetField": "Base_Carga", "label": { "pt-BR": "Base de Carga (BC)" } }
        },
        "levels": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/encumbranceLevel" },
          "description": "Encumbrance levels 0 (none) to 4 (extra-heavy), in order."
        }
      }
    },
    "damage": {
      "type": "object",
      "required": ["thrust", "swing"],
      "additionalProperties": false,
      "x-gurps": { "reference": "B16" },
      "properties": {
        "thrust": { "$ref": "#/$defs/dice", "x-gurps": { "role": "overridable", "formula": "lookup('thrust', $.attributes.st.value)", "sheetField": "Dano_GdP", "label": { "pt-BR": "Dano GdP (golpe de ponta)" } } },
        "swing": { "$ref": "#/$defs/dice", "x-gurps": { "role": "overridable", "formula": "lookup('swing', $.attributes.st.value)", "sheetField": "Dano_GeB", "label": { "pt-BR": "Dano GeB (golpe em balanço)" } } }
      }
    },
    "defenses": {
      "type": "object",
      "required": ["dodge", "parry", "block"],
      "additionalProperties": false,
      "properties": {
        "dodge": {
          "type": "object",
          "required": ["value"],
          "additionalProperties": false,
          "properties": {
            "value": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "floor($.secondary.basicSpeed.value) + 3", "reference": "B17", "sheetField": "Esquiva", "label": { "pt-BR": "Esquiva" }, "description": "Unencumbered. Enhanced Dodge and shield DB are not included in the formula." } }
          }
        },
        "parry": { "$ref": "#/$defs/skillDefense", "x-gurps": { "reference": "B376", "sheetField": "Aparar", "label": { "pt-BR": "Aparar" } } },
        "block": { "$ref": "#/$defs/skillDefense", "x-gurps": { "reference": "B375", "sheetField": "Bloqueio", "label": { "pt-BR": "Bloqueio" } } }
      }
    },
    "damageResistance": {
      "type": "array",
      "items": { "$ref": "#/$defs/drEntry" },
      "x-gurps": { "sheetField": "RD{n}a / RD{n}b (n=1..6)", "label": { "pt-BR": "RD" } }
    },
    "reactionModifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/reactionModifier" },
      "x-gurps": { "sheetField": "Reação_Aparencia, Status, Reputação1..5", "label": { "pt-BR": "Modificadores de Reação" } }
    },
    "techLevel": {
      "type": "object",
      "required": ["level", "points"],
      "additionalProperties": false,
      "x-gurps": { "reference": "B22", "sheetField": "NT / Custo_NT", "label": { "pt-BR": "NT (Nível Tecnológico)" } },
      "properties": {
        "level": { "type": ["integer", "null"], "x-gurps": { "role": "input" } },
        "points": { "type": "integer", "x-gurps": { "role": "input", "unit": "points", "description": "±5 per TL above/below the campaign TL." } }
      }
    },
    "languages": {
      "type": "array",
      "items": { "$ref": "#/$defs/language" },
      "x-gurps": { "reference": "B23", "sheetField": "Lingua{n} / Falada{n} / Escrita{n} / Custo_lingua_{n} (n=1..5)", "label": { "pt-BR": "Línguas" } }
    },
    "culturalFamiliarities": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedCost" },
      "x-gurps": { "reference": "B23", "sheetField": "FC{n} / Custo_FC{n} (n=1..3)", "label": { "pt-BR": "Familiaridades Culturais" } }
    },
    "traits": {
      "type": "array",
      "items": { "$ref": "#/$defs/trait" },
      "x-gurps": { "sheetField": "Vantagem{n} / Custo_Vantagem_{n} (n=1..12), Desvantagem{n} / Custo_desvantagem_{n} (n=1..13)", "label": { "pt-BR": "Vantagens e Desvantagens" } }
    },
    "skills": {
      "type": "array",
      "items": { "$ref": "#/$defs/skill" },
      "x-gurps": { "reference": "B170", "sheetField": "Pericia{n} / NH{n} / NH_Relativo_{n}A / NH_Relativo_{n}B / Tipo_{n} / Custo_Pericia_{n} (n=1..25)", "label": { "pt-BR": "Perícias" } }
    },
    "weapons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "melee": { "type": "array", "items": { "$ref": "#/$defs/meleeWeapon" }, "x-gurps": { "label": { "pt-BR": "Armas de combate corpo a corpo" } } },
        "ranged": { "type": "array", "items": { "$ref": "#/$defs/rangedWeapon" }, "x-gurps": { "label": { "pt-BR": "Armas de combate à distância" } } }
      }
    },
    "equipment": {
      "type": "array",
      "items": { "$ref": "#/$defs/equipmentItem" },
      "x-gurps": { "sheetField": "Armadura{n} / Posição{n} + matching Preço/Peso rows", "label": { "pt-BR": "Armadura & Posses" } }
    },
    "possessionsTotal": {
      "type": "object",
      "required": ["cost", "weight"],
      "additionalProperties": false,
      "properties": {
        "cost": { "type": "number", "x-gurps": { "role": "derived", "unit": "currency", "formula": "sum($.weapons.melee.cost) + sum($.weapons.ranged.cost) + sum($.equipment.cost)", "sheetField": "Preço_Total", "label": { "pt-BR": "Total $" } } },
        "weight": { "type": "number", "x-gurps": { "role": "derived", "unit": "kg", "formula": "sum($.weapons.melee.weight) + sum($.weapons.ranged.weight) + sum($.equipment.weight)", "sheetField": "Peso_Total", "label": { "pt-BR": "Total kg" } } }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "x-gurps": { "sheetField": "Anotações{n} (n=1..9)", "label": { "pt-BR": "Anotações do Personagem" } }
    },
    "extensions": {
      "type": "object",
      "description": "Engine-specific data. Keys must be reverse-DNS style namespaces (e.g. \"com.example.combat\") so tools never collide.",
      "propertyNames": { "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" }
    }
  },

  "$defs": {
    "primaryAttribute": {
      "type": "object",
      "required": ["value", "points"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0, "default": 10, "x-gurps": { "role": "input", "default": 10, "description": "10 is the free human average." } },
        "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - 10) * 10" } }
      }
    },
    "primaryAttributeDxIq": {
      "type": "object",
      "required": ["value", "points"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer", "minimum": 0, "default": 10, "x-gurps": { "role": "input", "default": 10, "description": "10 is the free human average." } },
        "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - 10) * 20" } }
      }
    },
    "secondaryFromIq5": {
      "type": "object",
      "required": ["value", "base", "points"],
      "additionalProperties": false,
      "x-gurps": { "costPerLevel": 5 },
      "properties": {
        "value": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "base" } },
        "base": { "type": "integer", "x-gurps": { "role": "derived", "formula": "$.attributes.iq.value" } },
        "points": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "points", "formula": "(value - base) * 5" } }
      }
    },
    "dice": {
      "type": "object",
      "required": ["notation", "dice", "adds"],
      "additionalProperties": false,
      "description": "Dice expression NdM-style: `dice` six-sided dice plus `adds`.",
      "properties": {
        "notation": { "type": "string", "pattern": "^\\d+d([+-]\\d+)?$", "examples": ["1d-2", "2d", "3d+1"] },
        "dice": { "type": "integer", "minimum": 0 },
        "adds": { "type": "integer" }
      }
    },
    "encumbranceLevel": {
      "type": "object",
      "required": ["level", "id", "maxLoad", "move", "dodge"],
      "additionalProperties": false,
      "x-gurps": { "reference": "B17" },
      "properties": {
        "level": { "type": "integer", "minimum": 0, "maximum": 4 },
        "id": { "enum": ["none", "light", "medium", "heavy", "extraHeavy"] },
        "maxLoad": { "type": "number", "x-gurps": { "role": "overridable", "unit": "kg", "formula": "round($.encumbrance.basicLift * lookup('encumbranceLoad', level), 1)", "sheetField": "Base_Carga_{Nenhuma|Leve|Media|Pesada|Mto_Pesada}" } },
        "move": { "type": "integer", "x-gurps": { "role": "overridable", "unit": "m", "formula": "floor($.secondary.basicMove.value * lookup('encumbranceMove', level))", "sheetField": "DB_{Nenhuma|Leve|Media|Pesada|Mto_Pesada}" } },
        "dodge": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "$.defenses.dodge.value - level", "sheetField": "Esquiva, Esquiva-1..4" } }
      }
    },
    "skillDefense": {
      "type": "object",
      "required": ["value", "skill"],
      "additionalProperties": false,
      "properties": {
        "skill": { "type": ["string", "null"], "description": "Name of the skill (in skills[]) this defense is based on.", "x-gurps": { "role": "input", "sheetField": "Aparar2 / Bloqueio2" } },
        "value": { "type": ["integer", "null"], "x-gurps": { "role": "overridable", "formula": "floor(skillLevel(skill) / 2) + 3", "description": "Weapon parry modifiers, shield DB and Combat Reflexes are not in the formula; an override carries them." } }
      }
    },
    "drEntry": {
      "type": "object",
      "required": ["location", "dr"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string", "description": "Location label as written on the sheet." },
        "locationId": { "enum": ["head", "skull", "face", "eyes", "neck", "torso", "vitals", "groin", "arms", "hands", "legs", "feet"], "description": "Normalized hit location for engines, when the label maps to one." },
        "dr": { "type": "integer", "minimum": 0, "x-gurps": { "role": "input", "reference": "B46" } },
        "notes": { "type": "string" }
      }
    },
    "reactionModifier": {
      "type": "object",
      "required": ["source", "description"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["appearance", "status", "reputation", "other"] },
        "description": { "type": "string" },
        "modifier": { "type": ["integer", "null"], "description": "Reaction roll modifier, when known." }
      }
    },
    "language": {
      "type": "object",
      "required": ["name", "spoken", "written", "points"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spoken": { "$ref": "#/$defs/comprehension" },
        "written": { "$ref": "#/$defs/comprehension" },
        "points": { "type": "integer", "x-gurps": { "role": "input", "unit": "points", "description": "Usually 0/1/2/3 per spoken and written level; native language at Native is free." } }
      }
    },
    "comprehension": {
      "enum": ["none", "broken", "accented", "native"],
      "x-gurps": { "label": { "pt-BR": "Nenhum / Rudimentar / Sotaque / Nativo" } }
    },
    "namedCost": {
      "type": "object",
      "required": ["name", "points"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "points": { "type": "integer", "x-gurps": { "role": "input", "unit": "points" } }
      }
    },
    "trait": {
      "type": "object",
      "required": ["name", "type", "points"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["advantage", "perk", "disadvantage", "quirk"], "description": "advantage/perk come from the sheet's Vantagens list; disadvantage/quirk from Desvantagens." },
        "points": { "type": "integer", "x-gurps": { "role": "input", "unit": "points", "description": "Negative for disadvantages and quirks." } },
        "level": { "type": "integer", "minimum": 1, "description": "Level for leveled traits, when known." },
        "notes": { "type": "string" }
      }
    },
    "skill": {
      "type": "object",
      "required": ["name", "attribute", "difficulty", "relativeLevel", "level", "points"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "attribute": { "enum": ["st", "dx", "iq", "ht", "will", "per"], "x-gurps": { "role": "input", "sheetField": "NH_Relativo_{n}A" } },
        "difficulty": { "enum": ["E", "A", "H", "VH"], "description": "Easy, Average, Hard, Very Hard (sheet: F, M, D, MD).", "x-gurps": { "role": "input", "sheetField": "Tipo_{n}" } },
        "relativeLevel": { "type": "integer", "x-gurps": { "role": "input", "sheetField": "NH_Relativo_{n}B" } },
        "level": { "type": "integer", "x-gurps": { "role": "overridable", "formula": "attr(attribute) + relativeLevel", "sheetField": "NH{n}" } },
        "points": { "type": "integer", "minimum": 1, "x-gurps": { "role": "overridable", "unit": "points", "formula": "lookup('skillCost', relativeLevel + lookup('difficultyOffset', difficulty))", "sheetField": "Custo_Pericia_{n}" } },
        "notes": { "type": "string" }
      }
    },
    "weaponDamage": {
      "type": "object",
      "required": ["notation"],
      "additionalProperties": false,
      "description": "Damage as written, plus optional structured parts for engines.",
      "properties": {
        "notation": { "type": "string", "minLength": 1, "examples": ["sw+2 cut", "thr+1 imp", "2d+1 pi"] },
        "base": { "enum": ["thrust", "swing", "fixed"] },
        "dice": { "type": "integer", "minimum": 0, "description": "Dice count when base is fixed." },
        "adds": { "type": "integer" },
        "type": { "enum": ["cr", "cut", "imp", "pi-", "pi", "pi+", "pi++", "burn", "cor", "fat", "tox", "tbb", "aff", "spec"] }
      }
    },
    "meleeWeapon": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "damage": {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/weaponDamage" },
          "description": "Damage per attack mode (e.g. swing and thrust); the sheet has two damage lines per melee weapon.",
          "x-gurps": { "sheetField": "DanoArma{n}ACC / DanoArma{n}BCC" }
        },
        "reach": { "type": "string", "examples": ["C", "1", "1,2"], "x-gurps": { "unit": "m" } },
        "parry": {
          "type": "object",
          "required": ["notation"],
          "additionalProperties": false,
          "properties": {
            "notation": { "type": "string", "examples": ["0", "-1", "0U", "No"] },
            "modifier": { "type": ["integer", "null"], "description": "Null when the weapon cannot parry." },
            "unbalanced": { "type": "boolean" }
          }
        },
        "notes": { "type": "string" },
        "cost": { "type": "number", "minimum": 0, "x-gurps": { "unit": "currency" } },
        "weight": { "type": "number", "minimum": 0, "x-gurps": { "unit": "kg" } }
      }
    },
    "rangedWeapon": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "damage": { "$ref": "#/$defs/weaponDamage" },
        "accuracy": { "type": "string", "examples": ["2", "3+1"], "x-gurps": { "label": { "pt-BR": "Prec" } } },
        "range": {
          "type": "object",
          "required": ["notation"],
          "additionalProperties": false,
          "properties": {
            "notation": { "type": "string", "examples": ["130/195", "x10/x15"] },
            "halfDamage": { "type": "number", "minimum": 0, "x-gurps": { "unit": "m" } },
            "max": { "type": "number", "minimum": 0, "x-gurps": { "unit": "m" } }
          },
          "x-gurps": { "label": { "pt-BR": "Distância" } }
        },
        "rateOfFire": { "type": "string", "examples": ["1", "3", "1x9"], "x-gurps": { "label": { "pt-BR": "CdT" } } },
        "shots": { "type": "string", "examples": ["1(2)", "30+1(3)"], "x-gurps": { "label": { "pt-BR": "Tiros" } } },
        "minST": { "type": "string", "examples": ["7", "10†"], "x-gurps": { "label": { "pt-BR": "ST" } } },
        "bulk": { "type": ["integer", "null"], "maximum": 0, "x-gurps": { "label": { "pt-BR": "Magnitude" } } },
        "recoil": { "type": ["integer", "null"], "minimum": 1, "description": "Null for weapons without recoil (bows, thrown).", "x-gurps": { "label": { "pt-BR": "RCO" } } },
        "legalityClass": { "type": ["integer", "null"], "minimum": 0, "maximum": 4, "x-gurps": { "label": { "pt-BR": "CL" } } },
        "notes": { "type": "string" },
        "cost": { "type": "number", "minimum": 0, "x-gurps": { "unit": "currency" } },
        "weight": { "type": "number", "minimum": 0, "x-gurps": { "unit": "kg" } }
      }
    },
    "equipmentItem": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string", "description": "Where it is worn or carried (sheet: Posição)." },
        "cost": { "type": "number", "minimum": 0, "x-gurps": { "unit": "currency" } },
        "weight": { "type": "number", "minimum": 0, "x-gurps": { "unit": "kg" } },
        "notes": { "type": "string" }
      }
    }
  },

