{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // dist/ is for outside consumers: they resolve @gurps-sheet/character to its dist/, not its source.
    "customConditions": [],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"]
}
