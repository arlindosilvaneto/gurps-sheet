{
  "name": "@gurps-sheet/character",
  "version": "0.1.0",
  "description": "Load, validate, verify and update GURPS 4th Edition characters (gurps-character JSON format) — for combat engines, VTT bridges and other tools.",
  "type": "module",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "@gurps-sheet/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formula": {
      "@gurps-sheet/source": "./src/formula.ts",
      "types": "./dist/formula.d.ts",
      "default": "./dist/formula.js"
    },
    "./constants": {
      "@gurps-sheet/source": "./src/constants.ts",
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./schema": "./schema/gurps-character.schema.json",
    "./vocabulary": "./schema/x-gurps-vocabulary.schema.json",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "schema",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "npm run typecheck && npm run test:unit && npm run types -- --check && npm run test:dist",
    "test:unit": "node --conditions=@gurps-sheet/source --import tsx --test test/*.test.ts",
    "test:dist": "npm run build && tsc -p test/consumer/tsconfig.json && node test/consumer/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "types": "node scripts/generate-types.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "gurps",
    "rpg",
    "character-sheet",
    "json-schema",
    "combat-engine"
  ]
}
