{
  "name": "gurps-sheet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:app && npm run test:lib",
    "test:app": "node --conditions=@gurps-sheet/source --import tsx --test test/",
    "test:lib": "npm test -w @gurps-sheet/character"
  },
  "dependencies": {
    "@gurps-sheet/character": "0.1.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
